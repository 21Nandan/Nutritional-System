# EATGOOD — Environment Configuration Example
# Copy this file to .env for custom deployment configurations

# Environment mode: development, production, test
EATGOOD_ENV=development
EATGOOD_DEBUG=true

# Server host and port
EATGOOD_HOST=127.0.0.1
EATGOOD_PORT=8000

# Allowed CORS Origins (comma-separated list for production)
EATGOOD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# File Upload Security Limits
EATGOOD_MAX_UPLOAD_MB=10

# Open Food Facts API Configuration
OFF_BASE_URL=https://world.openfoodfacts.org/api/v3/product
OFF_USER_AGENT=EATGOOD-NutritionScanner/1.0 (local-desktop; dev@eatgood.local)
OFF_TIMEOUT_SECONDS=8.0
OFF_CACHE_TTL_HOURS=168

# Rate Limiting (Requests Per Minute)
EATGOOD_RATE_LIMIT=true
RATE_LIMIT_OCR_RPM=20
RATE_LIMIT_OFF_RPM=45
RATE_LIMIT_CONTRIB_RPM=30
