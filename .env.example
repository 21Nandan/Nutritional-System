# EATGOOD configuration. Every variable is optional; defaults are shown.
# Copy to .env for local overrides. No secrets are needed.

# development | test | production
EATGOOD_ENV=development

# Comma-separated list of allowed cross-origin callers. '*' is rejected.
# Production serves the frontend from the same origin, so this only matters for the Vite dev server.
EATGOOD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite file for the Open Food Facts cache and contributions (defaults to /tmp/eatgood_app.db on Vercel)
# EATGOOD_DB_PATH=data/eatgood_app.db


# Open Food Facts API
OFF_BASE_URL=https://world.openfoodfacts.org/api/v3/product
OFF_USER_AGENT=EATGOOD/1.1 (+https://github.com/21Nandan/Nutritional-System)
OFF_TIMEOUT_SECONDS=8.0
OFF_CACHE_TTL_HOURS=168

# Rate limits, requests per minute per client IP (per server instance)
EATGOOD_RATE_LIMIT=true
RATE_LIMIT_OFF_SEARCH_RPM=60
RATE_LIMIT_OFF_RPM=45
RATE_LIMIT_CONTRIB_RPM=30

# Optional photo reading, explanations and the food coach. Without a key, every feature uses its
# built-in fallback. Never commit a real key: put it in .env locally and in Vercel's settings.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_TEXT_MODEL=gemini-flash-lite-latest
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# GEMINI_DAILY_LIMIT=200
# GEMINI_TIMEOUT_SECONDS=6.0
# RATE_LIMIT_AI_RPM=6
